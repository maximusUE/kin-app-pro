{
  "name": "codigo-propio-core",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dashboard": "next dev",
    "pilot": "tsx src/scripts/runPilotTest.ts",
    "trends": "node --experimental-strip-types src/scripts/trendAgent.ts",
    "factory": "node --experimental-strip-types src/scripts/testRunner.ts",
    "bot": "node --experimental-strip-types src/scripts/telegramBot.ts",
    "documentary": "node --experimental-strip-types src/scripts/documentaryAgent.ts",
    "studio": "node --experimental-strip-types src/scripts/testRunner.ts & node --experimental-strip-types src/scripts/telegramBot.ts",
    "compile": "node_modules/.bin/tsc --outDir dist --module commonjs --target es2020 --esModuleInterop true --resolveJsonModule true --skipLibCheck true src/scripts/testRunner.ts",
    "factory:compiled": "npm run compile && node dist/testRunner.js",
    "test:qa": "node --experimental-strip-types src/scripts/qaSyntheticTests.ts",
    "rates": "node --experimental-strip-types src/scripts/compareRates.ts",
    "test:e2e": "npx @testsprite/testsprite-cli test list --project 9f6fc3fd-ac03-4840-8ad6-676fcaede252",
    "test:credits": "npx @testsprite/testsprite-cli usage"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.118.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.9",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "googleapis": "^188.0.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.1",
    "telegraf": "^4.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
